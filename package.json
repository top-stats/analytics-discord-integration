{
  "name": "@topstats/discord",
  "version": "0.1.0",
  "description": "Official TopStats Analytics integration for discord.js bots. Automatic event tracking plus a track() for your own events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/top-stats/analytics-discord-integration.git"
  },
  "homepage": "https://docs.topstats.gg/docs/analytics",
  "bugs": {
    "url": "https://github.com/top-stats/analytics-discord-integration/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:manifests",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:manifests": "node scripts/write-module-manifests.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@topstats/analytics": "^0.1.0"
  },
  "peerDependencies": {
    "discord.js": ">=14"
  },
  "peerDependenciesMeta": {
    "discord.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
